# Database
DATABASE_URL="postgresql://user:password@localhost:5432/ehealth_africa"

# Authentication
JWT_SECRET="your-very-secure-jwt-secret-min-32-chars"
NEXTAUTH_SECRET="your-nextauth-secret"
NEXTAUTH_URL="http://localhost:3000"

# MFA / OTP
TWILIO_ACCOUNT_SID="your-twilio-account-sid"
TWILIO_AUTH_TOKEN="your-twilio-auth-token"
TWILIO_PHONE_NUMBER="+1234567890"

# File storage (for lab reports, imaging)
AWS_S3_BUCKET="ehealth-africa-files"
AWS_REGION="af-south-1"
AWS_ACCESS_KEY_ID="your-access-key"
AWS_SECRET_ACCESS_KEY="your-secret-key"

# SMTP (for notifications)
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_USER="noreply@ehealth-africa.gh"
SMTP_PASS="your-smtp-password"

# National ID API
NATIONAL_ID_API_URL="https://api.nia.gov.gh"
NATIONAL_ID_API_KEY="your-nia-api-key"

# QR Code generation
QRCODE_SECRET="your-qrcode-signing-secret"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="EHealth Africa"
